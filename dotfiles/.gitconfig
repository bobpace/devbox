[user]
  name = Bob Pace
  email = bob.pace@getweave.com

[core]
  autocrlf = input
  editor = /usr/local/bin/vim

[color]
  ui = true
  status = auto
  branch = auto
  diff = auto
  interactive = auto

[push]
  default = tracking
  autoSetupRemote = true

[pull]
  #ff = only
  rebase = false

[alias]
  fmerge = merge --ff-only
  st = status -s
  ci = commit
  cia = commit --amend -C HEAD
  ciara = cia -a --reset-author
  co = checkout
  df = diff
  ds = diff --stat
  di = diff --cached
  dft = difftool
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative 
  pr = remote prune origin
  rv = remote -v
  ro = remote show origin
  fh = log -p --full-diff
  ba = branch -a
  bm = branch --merged
  cob = checkout -b
  new = log master..
  rbc = rebase --continue
  bm = branch --merged
  stash-revert = "!git stash show -p | git apply -R"
  stashki = stash save --keep-index
  undo = reset HEAD^
  unci = reset --soft HEAD@{1}
  pu = ![[ $(git config "branch.$(git symbolic-ref --short HEAD).merge") = '' ]] && git push -u origin $(git symbolic-ref --short HEAD) || git push
  fs = "!f() { git fetch origin main:main && git switch main -c $1 && git merge --squash -;}; f"

[branch]
  autosetupmerge = true

[merge]
  #tool = vimdiff
  tool = goland
  #tool = fugitive
  keepBackup = false
  keepTemporaries = false
  prompt = false
	conflictstyle = diff3

[diff]
  tool = vimdiff
  renames = copies
[mergetool "fugitive"]
	cmd = vim -f -c \"Gdiff\" \"$MERGED\"
  keepTemporaries = false
  prompt = false
[mergetool "goland"]
    cmd = /usr/local/bin/goland merge $LOCAL $REMOTE $BASE $MERGED
    trustExitCode = true
[mergetool]
	prompt = false
[pager]
	branch = false
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
